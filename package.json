{
  "name": "audio-vad-detector",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prepare": "mkdir -p public/vad && cp node_modules/@ricky0123/vad-web/dist/silero_vad_legacy.onnx public/vad/ 2>/dev/null && cp node_modules/onnxruntime-web/dist/*.wasm public/vad/ 2>/dev/null && cp node_modules/onnxruntime-web/dist/*.mjs public/vad/ 2>/dev/null || true",
    "lint": "oxlint",
    "preview": "vite preview",
    "vad:batch": "node scripts/batch-vad.mjs"
  },
  "dependencies": {
    "@ricky0123/vad-web": "^0.0.31",
    "lucide-react": "^1.47.0",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
